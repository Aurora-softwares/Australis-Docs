---
import '../styles/site.css';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const link = (path) => base + '/' + path.replace(/^\/+/, '');
const fs = await import('node:fs');
const path = await import('node:path');
const screenshots = [
  { title: 'Desktop', name: 'desktop.png', label: 'Graphical environment', detail: 'A look at the desktop as it takes shape.', tone: 'peach', symbol: '✳' },
  { title: 'Command shell', name: 'terminal.png', label: 'Core interaction', detail: 'Discover what you can do from the Australis shell.', tone: 'lavender', symbol: '›_' },
  { title: 'Boot and recovery', name: 'boot.png', label: 'System startup', detail: 'See how Australis comes to life, one stage at a time.', tone: 'butter', symbol: '✦' },
].map((shot) => ({
  ...shot,
  available: fs.existsSync(path.join(process.cwd(), 'public', 'screenshots', shot.name)),
}));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#fff7ed" />
    <meta name="description" content="Meet Australis OS, a from-scratch experimental operating system by Aurora Softwares. Explore how it works, find a guide, and follow its development." />
    <meta property="og:title" content="Australis OS — A whole new world to explore" />
    <meta property="og:description" content="A friendly home for learning about Australis OS, browsing screenshots, and exploring the documentation." />
    <meta property="og:type" content="website" />
    <link rel="icon" href={link('favicon.svg')} type="image/svg+xml" />
    <title>Australis OS — Welcome to a whole new world</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="haze-background" aria-hidden="true">
      <div class="haze-blob one"></div>
      <div class="haze-blob two"></div>
      <div class="haze-blob three"></div>
    </div>
    <div class="page-shell">
      <header class="topbar glass">
        <a class="brand" href={link('')} aria-label="Australis OS home">
          <img src={link('favicon.svg')} alt="" width="38" height="38" />
          <span>Australis<span class="brand-point">.</span></span>
        </a>
        <nav aria-label="Main navigation">
          <a href={link('docs/')}>Documentation</a>
          <a href="#guides">How-to guides</a>
          <a href="#gallery">Screenshots</a>
          <a class="github-link" href="https://github.com/Aurora-softwares/Australis-OS" target="_blank" rel="noopener noreferrer">GitHub <span aria-hidden="true">↗</span></a>
        </nav>
      </header>

      <main id="main">
        <section class="hero" aria-labelledby="hero-title">
          <div class="hero-copy">
            <p class="eyebrow"><span class="eyebrow-dot" aria-hidden="true"></span> A little operating system with big ideas</p>
            <h1 id="hero-title">Hello, <span class="gradient-word">Australis.</span><br />A whole new world to explore.</h1>
            <p class="intro">Welcome to Australis OS — an operating system built from the ground up with Hydrogen. Get to know the project, explore its early capabilities, and discover how every part fits together.</p>
            <div class="hero-actions">
              <a class="button primary" href={link('docs/getting-started/first-steps/')}>Get started <span aria-hidden="true">→</span></a>
              <a class="button secondary" href={link('docs/')}>Explore the docs <span aria-hidden="true">↗</span></a>
            </div>
            <p class="release-note">Australis is an <strong>experimental OS</strong>, not a finished desktop product. <a href={link('docs/getting-started/faq/')}>What can it do today?</a></p>
          </div>
          <div class="hero-art" aria-label="Illustration of an Australis OS desktop, not a real screenshot">
            <span class="art-spark spark-one" aria-hidden="true">✳</span>
            <span class="art-spark spark-two" aria-hidden="true">✦</span>
            <div class="code-card glass">
              <div class="code-top">
                <div class="window-dots" aria-hidden="true"><i></i><i></i><i></i></div>
                <span>Australis OS · Preview</span>
                <span class="language-mark">OS</span>
              </div>
              <div class="desktop-preview" aria-hidden="true">
                <div class="preview-sun"></div>
                <div class="preview-hill first"></div>
                <div class="preview-hill second"></div>
                <div class="desktop-mini-window">
                  <span class="desktop-mini-mark">✳</span>
                  <small>A NEW BEGINNING</small>
                  <strong>Welcome to<br />Australis.</strong>
                  <span>Build · Learn · Explore</span>
                </div>
                <div class="mini-dock">⌂ <span>▣</span> <span>⌘</span> ⚙</div>
              </div>
              <div class="terminal"><span class="terminal-label">CONCEPT PREVIEW · NOT AN ACTUAL OS SCREENSHOT</span><span class="terminal-prompt">❯</span> Welcome to Australis <span class="terminal-cursor" aria-hidden="true"></span></div>
            </div>
            <div class="hero-sticker glass"><span class="sticker-mark" aria-hidden="true">✧</span><span>Made to explore ✳</span></div>
          </div>
        </section>

        <section class="welcome-note glass" aria-label="About Australis">
          <div class="note-icon" aria-hidden="true">✳</div>
          <div>
            <h2>What's Australis?</h2>
            <p>A from-scratch operating system built with the Hydrogen programming language. Its own bootloader, kernel, filesystem and applications are being developed step by step. For now, it's best explored in a virtual machine.</p>
          </div>
          <a href={link('docs/architecture/overview/')}>Learn more <span aria-hidden="true">→</span></a>
        </section>

        <section class="section-block" id="guides" aria-labelledby="guides-heading">
          <div class="section-heading">
            <p class="section-kicker">A good place to begin</p>
            <h2 id="guides-heading">Explore at your own pace <span aria-hidden="true">✿</span></h2>
            <p>Small steps, approachable guides, and a little curiosity. No operating-system experience needed.</p>
          </div>
          <div class="guide-grid">
            <a class="feature-card peach glass" href={link('docs/getting-started/first-steps/')}>
              <span class="feature-symbol" aria-hidden="true">↓</span>
              <span class="card-small">01 · GET READY</span>
              <h3>Your first boot</h3>
              <p>Set up the development tools and start Australis safely inside QEMU.</p>
              <span class="card-arrow">Start here <span aria-hidden="true">→</span></span>
            </a>
            <a class="feature-card lilac glass" href={link('docs/getting-started/explore/')}>
              <span class="feature-symbol" aria-hidden="true">⌘</span>
              <span class="card-small">02 · SAY HELLO</span>
              <h3>Explore the system</h3>
              <p>Discover the command shell and see what's already working.</p>
              <span class="card-arrow">Take a tour <span aria-hidden="true">→</span></span>
            </a>
            <a class="feature-card mint glass" href={link('docs/architecture/overview/')}>
              <span class="feature-symbol" aria-hidden="true">▧</span>
              <span class="card-small">03 · LOOK INSIDE</span>
              <h3>How it works</h3>
              <p>Learn about the bootloader, kernel, filesystem and applications.</p>
              <span class="card-arrow">Explore architecture <span aria-hidden="true">→</span></span>
            </a>
          </div>
        </section>

        <section class="section-block" id="gallery" aria-labelledby="gallery-heading">
          <div class="section-heading">
            <p class="section-kicker">A peek behind the scenes</p>
            <h2 id="gallery-heading">Australis, one step at a time</h2>
            <p>Follow the graphical environment, shell and startup process. Real screenshots appear here when verified captures are added; other previews are clearly labelled illustrations.</p>
          </div>
          <div class="sample-grid">
            {screenshots.map((shot, index) => (
              <article class="sample-card glass">
                <div class:list={['sample-preview', shot.tone, 'screenshot-preview']}>
                  {shot.available ? (
                    <img src={link('screenshots/' + shot.name)} alt={'Actual Australis OS screenshot: ' + shot.title} loading="lazy" />
                  ) : (
                    <>
                      <span class="preview-number">0{index + 1}</span>
                      <strong class="placeholder-title">{shot.title}<em aria-hidden="true">{shot.symbol}</em></strong>
                      <span class="placeholder-caption">ILLUSTRATION · NO SCREENSHOT YET</span>
                    </>
                  )}
                </div>
                <div class="sample-content">
                  <span class="sample-level">{shot.available ? 'Verified OS capture' : 'Illustrative preview'} · {shot.label}</span>
                  <h3>{shot.title}</h3>
                  <p>{shot.detail}</p>
                  <a href={link('docs/getting-started/explore/')}>Explore Australis <span aria-hidden="true">→</span></a>
                </div>
              </article>
            ))}
          </div>
          <div class="sample-footer">
            <p>Illustrations are not screenshots of a working desktop. Real captures can be added via <a href="https://github.com/Aurora-softwares/Australis-Docs/tree/Release/public/screenshots" target="_blank" rel="noopener noreferrer">the screenshots folder</a>.</p>
            <a href="https://github.com/Aurora-softwares/Australis-OS/tree/Development" target="_blank" rel="noopener noreferrer">Explore the current source <span aria-hidden="true">↗</span></a>
          </div>
        </section>

        <section class="docs-section glass" aria-labelledby="docs-heading">
          <div class="docs-copy">
            <p class="section-kicker">Everything in one place</p>
            <h2 id="docs-heading">Your curiosity, meet the docs.</h2>
            <p>Find simple getting-started guides, explore core components, or dig into detailed technical references — all in a calm, searchable place.</p>
            <a class="button primary" href={link('docs/')}>Open documentation <span aria-hidden="true">→</span></a>
          </div>
          <div class="docs-links" aria-label="Documentation shortcuts">
            <a href={link('docs/getting-started/first-steps/')}><span aria-hidden="true">◇</span><span><strong>Getting started</strong><small>Tools, building, and your first boot</small></span><span aria-hidden="true">↗</span></a>
            <a href={link('docs/architecture/overview/')}><span aria-hidden="true">⌘</span><span><strong>Architecture &amp; kernel</strong><small>How everything fits together</small></span><span aria-hidden="true">↗</span></a>
            <a href={link('docs/applications/platform/')}><span aria-hidden="true">▣</span><span><strong>Applications</strong><small>Make programs with Hydrogen</small></span><span aria-hidden="true">↗</span></a>
            <a href={link('docs/development/os-roadmap/')}><span aria-hidden="true">✧</span><span><strong>What's next?</strong><small>Follow the development roadmap</small></span><span aria-hidden="true">↗</span></a>
          </div>
        </section>

        <section class="closing">
          <span aria-hidden="true">✳</span>
          <h2>Every great project starts somewhere.</h2>
          <p>Explore the code, try something new, and enjoy seeing Australis grow.</p>
          <a class="button secondary" href="https://github.com/Aurora-softwares/Australis-OS" target="_blank" rel="noopener noreferrer">See the source <span aria-hidden="true">→</span></a>
        </section>
      </main>

      <footer class="footer">
        <span><img src={link('favicon.svg')} width="24" height="24" alt="" /> Australis by <a href="https://github.com/Aurora-softwares">Aurora Softwares</a></span>
        <span>
          <a href={link('docs/')}>Documentation</a>
          <a href="https://github.com/Aurora-softwares/Australis-OS">GitHub</a>
          <a href="https://hylang.co.uk/">Hydrogen</a>
          <a href={link('docs/development/os-roadmap/')}>Roadmap</a>
        </span>
      </footer>
    </div>
  </body>
</html>
